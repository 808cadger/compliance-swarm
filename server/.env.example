NODE_ENV=production
PORT=4210
POSTGRES_USER=compliance_swarm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=compliance_swarm
POSTGRES_APP_PASSWORD=changeme-app
# Host `postgres` and port 5432 here are the container-network address of the postgres
# service, not a host port -- correct for both dev and production, and unaffected by the
# dev override's 5433 host publish. Only host-side tooling (see TEST_DATABASE_URL below)
# uses localhost:5433.
DATABASE_URL=postgres://compliance_swarm_app:changeme-app@postgres:5432/compliance_swarm
COOKIE_SECRET=changeme-to-a-long-random-string
TZ=Pacific/Honolulu

# Test runs only (never set in a deployed .env). Required by `npm test`, which has no
# DATABASE_URL fallback because production shares this database name.
#
# Port 5433 below is the DEV-ONLY host port -- it is not a general default. Postgres
# listens on 5433 only when the dev stack is brought up through the local override:
#
#   cd server && docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres
#
# Host port 5432 belongs to the production Postgres container; never point a test run there.
# TEST_DATABASE_URL=postgres://compliance_swarm_app:changeme-app@localhost:5433/compliance_swarm_test
