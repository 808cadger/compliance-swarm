{
  "version": 1,
  "defaults": {
    "provider": "anthropic",
    "model": "claude-sonnet-5",
    "maxTokens": 1200,
    "temperature": 0.1
  },
  "agents": {
    "books_review": {
      "maxTokens": 1200,
      "temperature": 0
    },
    "contract_review": {
      "maxTokens": 1600,
      "temperature": 0
    },
    "payroll_explainer": {
      "provider": "ollama",
      "endpoint": "http://localhost:11434/api/chat",
      "model": "llama3.1:8b",
      "maxTokens": 700,
      "temperature": 0
    }
  },
  "policy": {
    "allowCloud": true,
    "allowLocal": true,
    "requireHumanApproval": true,
    "allowExecutedActions": false
  }
}
